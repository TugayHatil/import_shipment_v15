<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_import_doc_attachment_user" model="ir.rule">
        <field name="name">Import documents hidden from non-managers</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">[('import_doc','=',False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_import_doc_attachment_manager" model="ir.rule">
        <field name="name">Import documents visible to managers</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('stock_picking_import_docs.group_import_docs_manager'))]"/>
    </record>
</odoo>
