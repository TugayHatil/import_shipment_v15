<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_import_docs" model="ir.ui.view">
        <field name="name">stock.picking.form.import.docs</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[last()]" position="after">
                <page name="import_docs" string="Import"
                      groups="stock_picking_import_docs.group_import_docs_manager">
                    <group name="import_docs_files">
                        <field name="import_invoice_filename" invisible="1"/>
                        <field name="import_invoice_file" filename="import_invoice_filename"/>
                        <field name="packing_list_filename" invisible="1"/>
                        <field name="packing_list_file" filename="packing_list_filename"/>
                        <field name="bill_of_lading_filename" invisible="1"/>
                        <field name="bill_of_lading_file" filename="bill_of_lading_filename"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
