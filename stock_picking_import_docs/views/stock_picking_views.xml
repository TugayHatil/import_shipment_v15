<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_import_docs" model="ir.ui.view">
        <field name="name">stock.picking.form.import.docs</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[last()]" position="after">
                <page name="import_docs" string="Import"
                      groups="stock_picking_import_docs.group_import_docs_manager">
                    <div class="o_import_docs">
                        <group col="4" name="import_docs_wrap">
                            <group string="Import Invoice" name="import_invoice_group">
                                <field name="import_invoice_attachment_ids" nolabel="1"
                                       widget="import_docs_multi"/>
                            </group>
                            <group string="Packing List" name="packing_list_group">
                                <field name="packing_list_attachment_ids" nolabel="1"
                                       widget="import_docs_multi"/>
                            </group>
                            <group string="Bill of Lading" name="bill_of_lading_group">
                                <field name="bill_of_lading_attachment_ids" nolabel="1"
                                       widget="import_docs_multi"/>
                            </group>
                            <group string="Customs Declaration" name="customs_declaration_group">
                                <field name="customs_declaration_attachment_ids" nolabel="1"
                                       widget="import_docs_multi"/>
                            </group>
                        </group>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
